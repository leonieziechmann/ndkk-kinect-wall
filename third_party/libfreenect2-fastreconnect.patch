 bool CommandTransaction::execute(const CommandBase& command, Result& result)
 {
+  // FASTRECONNECT: per-command timing (LIBFREENECT2_LOGGER_LEVEL=debug)
+  struct Timed
+  {
+    const CommandBase &cmd;
+    std::chrono::steady_clock::time_point start;
+    explicit Timed(const CommandBase &c) : cmd(c), start(std::chrono::steady_clock::now()) {}
+    ~Timed()
+    {
+      double ms = std::chrono::duration<double, std::milli>(
+                    std::chrono::steady_clock::now() - start).count();
+      uint32_t id = reinterpret_cast<const uint32_t *>(cmd.data())[3];
+      LOG_DEBUG << "command 0x" << std::hex << id << std::dec << " took " << ms << " ms";
+    }
+  } timed(command);
+
   result.resize(command.maxResponseLength());
   response_complete_result_.resize(ResponseCompleteLength);
 
