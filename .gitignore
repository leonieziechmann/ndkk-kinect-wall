# build output
kinect-hub/target/
# onnxruntime.dll for the pose model: fetched by kinect-hub/setup-onnxruntime.ps1
kinect-hub/onnxruntime/
fn2/bin/
__pycache__/
*.pyc
# leftovers of the removed browser workshop web/ (node_modules, .cache: may show the room / people;
# wall-bevy takes the wall documents over from web/.cache/wall/ once)
web/

# third-party sources and builds: recreated by third_party/setup.sh
third_party/*
!third_party/setup.sh
!third_party/libfreenect2-fastreconnect.patch

# local recordings, logs and measurements (may show the room / people)
recordings/
*.k2rec
# raw depth packets and cached calibrations of kinect-driver / fn2_rawdump
*.k2raw
*.k2raw.head
*.k2cal
*.k2rec.part
snapshots/
fn2/logs/
*.csv
*.log
# wall-bevy (native output): build output; its data folder (setup, projections, show, pairing code)
wall-bevy/target/
wall-bevy/data/

# agent worktrees (Claude Code)
.claude/worktrees/
# kinect-driver (Rust driver): build output
kinect-driver/target/
